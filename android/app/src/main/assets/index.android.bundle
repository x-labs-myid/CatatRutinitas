maneh'},jawa:{aku:'kula',kamu:'kowe'},minang:{aku:'denai',kamu:'ang'},betawi:{aku:'gue',kamu:'lu'}},e.listMonthID=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'],e.listMonthEN=['January','February','March','April','May','June','July','August','September','October','November','December'],e.listMonthMY=['Januari','Februari','Mac','April','Mei','Jun','Julai','Ogos','September','Oktober','November','Disember'],e.listWordNotification=["Selamat pagi \ud83c\udf1e! Yuk mulai hari dengan rutinitas positif kamu.","Gaspol lagi hari ini \ud83d\ude80, jangan skip biar habit makin nempel!","Konsisten bikin kamu makin keren tiap harinya \u2728","Semangat terus jangan kendor!","Yuk isi hari kamu dengan rutinitas positif \ud83c\udf31","Step kecil tiap hari = hasil gede nanti \ud83d\udcaf","Jangan kasih ruang buat males, ayo gerak dikit \ud83d\udcaa","Positive vibes only \u270c\ufe0f, waktunya rutinitas kamu hari ini!","Kamu udah hebat banget bisa konsisten sejauh ini \ud83d\udd25","Tambahin energi positif buat diri kamu sendiri hari ini \u26a1","Cuma butuh beberapa menit, efeknya bisa seharian \ud83d\ude0e","Yuk upgrade diri kamu, satu langkah kecil tiap hari \ud83c\udfaf","Jangan lupa self-care, rutinitas kamu penting buat kesehatan \ud83d\udc9a","Konsistensi = power. kamu pasti bisa bro/sis! \ud83d\udca5","Waktunya jadi versi terbaik dari diri kamu sendiri \u2728","Jangan tunggu mood, bikin mood kamu naik dengan rutinitas \ud83d\ude01","Hari ini ayo lakuin rutinitas positif kamu \ud83c\udf1f","Udah sejauh ini, jangan berhenti ya! Keep going \ud83d\ude4c","Fokus ke progress, nikmati prosesnya \ud83d\udeb6","Ayo buktiin kalo kamu bisa disiplin + konsisten \ud83d\udd11"],e.listWordNotificationEN=["Good morning \ud83c\udf1e! Let\u2019s start the day with your positive routine.","Full throttle today \ud83d\ude80, don\u2019t skip so your habit sticks!","Consistency makes you cooler every day \u2728","Keep the spirit up, don\u2019t slack off!","Let\u2019s fill your day with positive routines \ud83c\udf31","Small steps every day = big results later \ud83d\udcaf","No room for laziness, let\u2019s move a bit \ud83d\udcaa","Positive vibes only \u270c\ufe0f, it\u2019s time for your routine today!","You\u2019ve done great being consistent so far \ud83d\udd25","Add some positive energy to yourself today \u26a1","Just a few minutes can have an all-day effect \ud83d\ude0e","Let\u2019s upgrade yourself, one small step at a time \ud83c\udfaf","Don\u2019t forget self-care, your routine matters for your health \ud83d\udc9a","Consistency = power. You got this bro/sis! \ud83d\udca5","Time to be the best version of yourself \u2728","Don\u2019t wait for the mood, boost it with your routine \ud83d\ude01","Let\u2019s do your positive routine today \ud83c\udf1f","You\u2019ve come this far, don\u2019t stop now! Keep going \ud83d\ude4c","Focus on progress, enjoy the process \ud83d\udeb6","Prove that you can be disciplined + consistent \ud83d\udd11"],e.listWordNotificationMY=["Selamat pagi \ud83c\udf1e! Jom mulakan hari dengan rutin positif anda.","Teruskan semangat hari ini \ud83d\ude80, jangan tinggal supaya tabiat makin mantap!","Konsisten buat anda makin hebat setiap hari \u2728","Teruskan semangat, jangan mengalah!","Jom isi hari anda dengan rutin yang positif \ud83c\udf31","Langkah kecil setiap hari = hasil besar nanti \ud83d\udcaf","Jangan beri ruang untuk malas, gerak sikit pun dah cukup \ud83d\udcaa","Hanya aura positif \u270c\ufe0f, masa untuk rutin anda hari ini!","Anda dah sangat hebat sebab konsisten sampai sekarang \ud83d\udd25","Tambah tenaga positif untuk diri anda hari ini \u26a1","Beberapa minit saja cukup untuk beri kesan sepanjang hari \ud83d\ude0e","Jom tingkatkan diri anda, satu langkah kecil setiap hari \ud83c\udfaf","Jangan lupa jaga diri, rutin anda penting untuk kesihatan \ud83d\udc9a","Konsistensi = kuasa. Anda pasti boleh bro/sis! \ud83d\udca5","Masa untuk jadi versi terbaik diri anda \u2728","Jangan tunggu mood, naikkan mood dengan rutin \ud83d\ude01","Hari ini, jom lakukan rutin positif anda \ud83c\udf1f","Dah sampai sejauh ini, jangan berhenti! Teruskan \ud83d\ude4c","Fokus pada kemajuan, nikmati prosesnya \ud83d\udeb6","Buktikan anda boleh berdisiplin + konsisten \ud83d\udd11"],e.listWordSleepNotification=["Udah malem nih, waktunya tidur biar besok fresh \u2728","Gas tidur dulu yuk, jangan kebanyakan scroll HP \ud83d\udcf1\ud83d\ude06","Besok kamu mau produktif kan? Tidur sekarang biar fit \ud83d\udcaa","Ingat, tidur cukup = energi full buat rutinitas besok \u26a1","Matikan layar, tarik selimut, saatnya bobok \ud83d\udecc","Begadang itu musuh produktifitas, yuk tidur cepet \ud83d\ude34","Tubuh kamu butuh istirahat, jangan dipaksa terus ya \ud83d\ude4c","Tidur yang cukup bikin mood besok lebih oke \ud83c\udfb6","Jangan kalah sama FOMO, tidur dulu biar sehat \ud83c\udf19","Kamu udah keren hari ini, reward buat diri = tidur nyenyak \ud83d\udca4","Stop kerja / main sekarang, recharge energi lewat tidur \ud83d\udd0b","Tidur awal bikin bangun pagi lebih gampang \u23f0","Besok banyak hal seru nunggu, yuk bobok dulu \u2728","Layar HP bisa nunggu, tapi badan kamu butuh tidur sekarang \ud83d\uded1","Selamat malam, semoga mimpi indah ya \ud83c\udf0c","Yuk rehat, tidur cukup biar otak makin encer besok \ud83e\udde0","Tidur itu bagian dari self-care, jangan di-skip \ud83d\udc95","Waktu tidur udah manggil, jangan cuekin ya \ud83d\ude06","Besok mau ngelakuin rutinitas positif? Tidur dulu dong \ud83c\udf1f","Good night, energi besok dimulai dari tidur malam ini \ud83c\udf1c"],e.listWordSleepNotificationEN=["It\u2019s already late, time to sleep so you\u2019re fresh tomorrow \u2728","Let\u2019s hit the bed, stop scrolling your phone too much \ud83d\udcf1\ud83d\ude06","Want to be productive tomorrow? Sleep now to stay fit \ud83d\udcaa","Remember, enough sleep = full energy for tomorrow\u2019s routine \u26a1","Turn off the screen, grab your blanket, it\u2019s bedtime \ud83d\udecc","Staying up late kills productivity, go to bed early \ud83d\ude34","Your body needs rest, don\u2019t push it too hard \ud83d\ude4c","Good sleep means better mood tomorrow \ud83c\udfb6","Don\u2019t lose to FOMO, sleep first for your health \ud83c\udf19","You did great today, reward yourself with quality sleep \ud83d\udca4","Stop working/playing now, recharge through sleep \ud83d\udd0b","Sleeping early makes waking up easier \u23f0","Lots of exciting things await tomorrow, get some sleep \u2728","The phone can wait, but your body needs rest now \ud83d\uded1","Good night, hope you have sweet dreams \ud83c\udf0c","Time to rest, enough sleep makes your brain sharper \ud83e\udde0","Sleep is part of self-care, don\u2019t skip it \ud83d\udc95","Sleep is calling, don\u2019t ignore it \ud83d\ude06","Planning to follow your routine tomorrow? Start with sleep \ud83c\udf1f","Good night, tomorrow\u2019s energy starts with tonight\u2019s sleep \ud83c\udf1c"],e.listWordSleepNotificationMY=["Dah malam ni, masa untuk tidur supaya esok segar \u2728","Jom tidur dulu, jangan asyik scroll HP \ud83d\udcf1\ud83d\ude06","Esok nak jadi produktif kan? Tidur sekarang supaya cergas \ud83d\udcaa","Ingat, tidur cukup = tenaga penuh untuk rutin esok \u26a1","Tutup skrin, tarik selimut, masa untuk tidur \ud83d\udecc","Tidur lewat musuh produktiviti, jom tidur awal \ud83d\ude34","Badan anda perlukan rehat, jangan paksa sangat \ud83d\ude4c","Tidur yang cukup buat mood esok lebih baik \ud83c\udfb6","Jangan kalah dengan FOMO, tidur dulu untuk kesihatan \ud83c\udf19","Anda dah hebat hari ini, ganjaran untuk diri = tidur lena \ud83d\udca4","Berhenti kerja / main sekarang, cas semula tenaga dengan tidur \ud83d\udd0b","Tidur awal mudahkan bangun pagi \u23f0","Banyak perkara menarik menanti esok, jom tidur dulu \u2728","Telefon boleh tunggu, tapi badan perlukan rehat sekarang \ud83d\uded1","Selamat malam, semoga mimpi indah \ud83c\udf0c","Jom rehat, tidur cukup buat otak lebih tajam esok \ud83e\udde0","Tidur adalah sebahagian daripada self-care, jangan skip \ud83d\udc95","Waktu tidur dah tiba, jangan abaikan \ud83d\ude06","Esok nak buat rutin positif? Tidur dulu lah \ud83c\udf1f","Selamat malam, tenaga esok bermula dari tidur malam ni \ud83c\udf1c"],e.bannerIdAds="ca-app-pub-9452447376164923/6313312851",e.interstitialIdAds="ca-app-pub-9452447376164923/8852858048"},682,[3]);
